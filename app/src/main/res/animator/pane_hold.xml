<?xml version="1.0" encoding="utf-8"?>
<!--
    Changes nothing, it only keeps a page on screen while the surrounding pane slides out, so the page
    does not vanish before the pane has closed. Matches the closing time of PaneLayout.
-->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:propertyName="alpha"
    android:valueFrom="1"
    android:valueTo="1"
    android:valueType="floatType" />
