<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/TextAppearance.Up.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:contentDescription="@string/semester_switch_description"
                    android:drawablePadding="@dimen/space_2"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="1"
                    app:drawableEndCompat="@drawable/ic_chevron_down"
                    app:drawableTint="@color/text_secondary" />

                <TextView
                    android:id="@+id/subtitle"
                    style="@style/TextAppearance.Up.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Order of the buttons: add a course, the courses, the settings. -->
            <de.mcmodersd.unipensum.ui.widget.UpIconButton
                android:id="@+id/add_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/add_course_description"
                android:src="@drawable/ic_add" />

            <de.mcmodersd.unipensum.ui.widget.UpIconButton
                android:id="@+id/open_courses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/courses_description"
                android:src="@drawable/ic_list" />

            <de.mcmodersd.unipensum.ui.widget.UpIconButton
                android:id="@+id/open_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings_description"
                android:src="@drawable/ic_sliders" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.Up.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_title" />

        <TextView
            style="@style/TextAppearance.Up.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/empty_body" />

        <de.mcmodersd.unipensum.ui.widget.UpButton
            android:id="@+id/create_semester"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:text="@string/empty_action" />
    </LinearLayout>

</FrameLayout>
