<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale. The font family is set once here, so the app can switch typeface in one place. -->
    <style name="TextAppearance.Up" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Up.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Up.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Up.Body">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Up.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Heading above a group of fields in the editors. -->
    <style name="TextAppearance.Up.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="TextAppearance.Up.Error">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/danger</item>
    </style>
</resources>
